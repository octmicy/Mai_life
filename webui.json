{
  "schema_version": 2,
  "required_capabilities": [
    "custom_pages",
    "image_upload",
    "structured_arguments"
  ],
  "workspace_title": "麦生活",
  "pages": [
    {
      "id": "overview",
      "title": "麦麦此刻",
      "description": "实时生活状态、情绪罗盘、72h 轨迹、今日日程与 Token 监控",
      "icon": "chart",
      "mode": "custom",
      "entry": "webui/overview.html",
      "layout": "document",
      "queries": {
        "status": {
          "api": "webui_status_overview",
          "version": "1"
        },
        "history": {
          "api": "webui_status_history",
          "version": "1"
        },
        "schedule": {
          "api": "webui_schedule",
          "version": "1"
        },
        "usage": {
          "api": "webui_usage",
          "version": "1"
        }
      }
    },
    {
      "id": "life",
      "title": "记忆与牵挂",
      "description": "社交关系温度、重要日期、日记与梦境手账、书柜作品与联网见闻",
      "icon": "puzzle",
      "mode": "custom",
      "entry": "webui/life.html",
      "layout": "document",
      "queries": {
        "users": {
          "api": "webui_users",
          "version": "1"
        },
        "dates": {
          "api": "webui_dates",
          "version": "1"
        },
        "memories": {
          "api": "webui_memories",
          "version": "1"
        },
        "shelf": {
          "api": "webui_bookshelf_overview",
          "version": "1"
        },
        "digest": {
          "api": "webui_information_digest",
          "version": "1"
        },
        "template_get": {
          "api": "webui_schedule_template_get",
          "version": "1"
        },
        "template_preview": {
          "api": "webui_schedule_template_preview",
          "version": "1"
        }
      },
      "actions": {
        "date_write": {
          "api": "webui_date_write",
          "version": "1",
          "parameters": {
            "event_name": {"type": "string", "required": true, "max_length": 120},
            "user_id": {"type": "string", "required": true, "max_length": 64},
            "calendar": {"type": "string", "required": true, "choices": ["solar", "lunar"]},
            "recurrence": {"type": "string", "required": true, "choices": ["none", "annual"]},
            "date": {"type": "string", "required": true, "max_length": 10}
          },
          "confirmation": "确认写入这条重要日期？公历存 YYYY-MM-DD，农历按平月存 月-日。"
        },
        "date_delete": {
          "api": "webui_date_delete",
          "version": "1",
          "parameters": {
            "date_id": {"type": "integer", "required": true, "minimum": 1}
          },
          "confirmation": "确认删除这条重要日期？删除后不再提醒。"
        },
        "candidate_set": {
          "api": "webui_date_candidate_set",
          "version": "1",
          "parameters": {
            "candidate_id": {"type": "integer", "required": true, "minimum": 1},
            "approve": {"type": "boolean", "required": true}
          },
          "confirmation": "确认处理这条日期候选？确认将按建议日期写入正式日期，驳回将标记忽略。"
        },
        "book_import_check": {
          "api": "webui_book_import_check",
          "version": "1",
          "parameters": {
            "title": {"type": "string", "required": true, "max_length": 160},
            "sha256": {"type": "string", "required": false, "max_length": 64},
            "total_chars": {"type": "integer", "required": true, "minimum": 0}
          }
        },
        "book_import_begin": {
          "api": "webui_book_import_begin",
          "version": "1",
          "parameters": {
            "title": {"type": "string", "required": true, "max_length": 160},
            "author": {"type": "string", "required": false, "max_length": 120},
            "sha256": {"type": "string", "required": false, "max_length": 64},
            "total_chars": {"type": "integer", "required": true, "minimum": 1},
            "privacy": {"type": "string", "required": true, "choices": ["private", "public"]}
          }
        },
        "book_import_chunk": {
          "api": "webui_book_import_chunk",
          "version": "1",
          "parameters": {
            "import_id": {"type": "string", "required": true, "max_length": 64},
            "seq": {"type": "integer", "required": true, "minimum": 0},
            "text": {"type": "string", "required": true, "max_length": 65536}
          }
        },
        "book_import_commit": {
          "api": "webui_book_import_commit",
          "version": "1",
          "parameters": {
            "import_id": {"type": "string", "required": true, "max_length": 64}
          },
          "confirmation": "确认把这本书导入书柜？导入后默认仅主人可见。"
        },
        "book_import_cancel": {
          "api": "webui_book_import_cancel",
          "version": "1",
          "parameters": {
            "import_id": {"type": "string", "required": true, "max_length": 64}
          }
        },
        "book_read": {
          "api": "webui_book_read",
          "version": "1",
          "parameters": {
            "document_id": {"type": "string", "required": true, "max_length": 64},
            "offset": {"type": "integer", "required": true, "minimum": 0},
            "limit": {"type": "integer", "required": true, "minimum": 1, "maximum": 20000}
          }
        },
        "schedule_template_save": {
          "api": "webui_schedule_template_save",
          "version": "1",
          "parameters": {
            "template": {"type": "object", "required": true}
          },
          "confirmation": "确认保存日程模板？保存后以后生成时生效（今天已生成的日程不变）。"
        },
        "schedule_regenerate_today": {
          "api": "webui_schedule_regenerate_today",
          "version": "1",
          "parameters": {},
          "confirmation": "确认重新生成今天的日程？整日框架将被替换，已发生的活动记录不保留。"
        }
      }
    },
    {
      "id": "system",
      "title": "设置与诊断",
      "description": "运行健康诊断、主动私聊候选与跳过统计、QQ 群白名单及全量只读配置",
      "icon": "settings",
      "mode": "custom",
      "entry": "webui/system.html",
      "layout": "document",
      "queries": {
        "config": {
          "api": "webui_config_summary",
          "version": "1"
        },
        "admin": {
          "api": "webui_admin_summary",
          "version": "1"
        }
      },
      "uploads": {
        "refs": {"action": "refs_upload", "image_max_edge": 2048}
      },
      "actions": {
        "refs_upload": {
          "api": "webui_persona_refs_upload",
          "version": "1",
          "parameters": {
            "upload_id": {"type": "string", "required": true, "max_length": 128},
            "name": {"type": "string", "required": false, "max_length": 60}
          }
        },
        "refs_delete": {
          "api": "webui_persona_refs_delete",
          "version": "1",
          "parameters": {
            "ref_id": {"type": "string", "required": true, "max_length": 64}
          },
          "confirmation": "确认删除这张默认角色参考图？删除后自拍场景回退文字引导。"
        },
        "save": {
          "api": "webui_config_save",
          "version": "1",
          "parameters": {
            "section": {"type": "string", "required": true, "max_length": 64},
            "key": {"type": "string", "required": true, "max_length": 64},
            "value": {"type": "string", "required": true, "max_length": 4000}
          },
          "confirmation": "确认修改该配置项？保存后写入 config.toml 并立即热生效。"
        }
      }
    }
  ]
}
